# Telegram bot
BOT_TOKEN=123456789:replace_with_your_bot_token
BOT_USERNAME=YourBookingBot

# Database type
DB_TYPE=postgresql

# PostgreSQL database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=booking_bot
DB_USER=postgres
DB_PASSWORD=replace_with_database_password

# Timezone
TIMEZONE=Europe/Moscow

# Admin user IDs (comma-separated)
ADMIN_IDS=123456789

# WebApp
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
WEBAPP_URL=https://your-domain.example

# MLM database
MLM_DB_HOST=localhost
MLM_DB_PORT=5432
MLM_DB_NAME=mlm_bot
MLM_DB_USER=postgres
MLM_DB_PASSWORD=replace_with_mlm_database_password

# MLM bot link
MLM_BOT_USERNAME=YourMlmBot

# PWA / Web Push (generate an ECDSA P-256 VAPID key pair; keep private key secret)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Business reminder timezone until per-business timezones are introduced
SERVGO_TIMEZONE=Europe/Moscow
# Sales consultant / ClaudeHub. Base URL includes the API prefix (e.g. /v1).
# Keep credentials outside Git. No production API calls until configured.
CLAUDEHUB_BASE_URL=
CLAUDEHUB_API_KEY=
CLAUDEHUB_MODEL=
CLAUDEHUB_API_FORMAT=openai

# AI Growth OS server-to-server settings integration (no browser/LLM access).
# Generate a separate random token, at least 32 characters. Empty scope grants no access.
SERVGO_PLATFORM_API_TOKEN=
SERVGO_PLATFORM_BUSINESS_IDS=

# Standalone email authentication: SMTP plus two independent random secrets.
# Set JWT_SECRET before enabling; changing it invalidates existing browser JWTs.
JWT_SECRET=
SERVGO_EMAIL_AUTH_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ServGo
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
